        -         minimum,
        -         maximum,
        -         step,
        -         options,
        -         id in SIGNAL_SETTINGS_ENUM_CHECKBOX_IDS ? "db" : nothing,
        -         id in SIGNAL_SETTINGS_ENUM_CHECKBOX_IDS ? "linear" : nothing,
        -         effect_status,
        -         effect_reason,
        -         visibility_policy,
        -         enabled_policy,
        -     )
