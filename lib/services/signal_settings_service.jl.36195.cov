       12 signal_settings_auto_default(key::Symbol) = NamedTuple{(:mode, key)}(("auto", nothing))
        - 
       82 function signal_settings_control_kind(id::AbstractString, kind::AbstractString)::String
      164     id in SIGNAL_SETTINGS_ENUM_CHECKBOX_IDS && return "checkbox"
       76     kind == "boolean" && return "checkbox"
       66     kind == "enum" && return "combobox"
       44     kind == "number" && return "number"
       30     kind == "integer" && return "integer"
       30     kind == "optional_range" && return "range"
       12     kind == "resolution" && return "resolution"
        2     kind == "power_bins" && return "power_bins"
        0     throw(ArgumentError("Нет control_kind для kind=$kind"))
        - end
