        -     ); status = if err.code in ("archive_size_limit", "archive_entry_limit", "archive_total_limit", "archive_file_limit")
        -         413
        -     elseif err.code == "workspace_unavailable"
        -         503
        -     elseif err.code == "workspace_provider_error"
        -         502
        -     else
        -         422
        -     end)
        - end
