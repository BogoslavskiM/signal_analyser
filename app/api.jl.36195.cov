        -         return nothing
        -     end
        -     try
        -         Int(value)
        -     catch err
        -         (err isa InexactError || err isa OverflowError) || rethrow()
        -         field_errors["state_revision"] = "Требуется целое число в диапазоне Int"
        -         nothing
        -     end
        - end
