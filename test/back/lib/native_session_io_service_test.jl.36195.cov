        1     real_signal = NIO.AnalysedSignal("one", "#111111", 10.0, ComplexF64[1, 2], false, true)
        1     complex_signal = NIO.AnalysedSignal("two", "#222222", 10.0, ComplexF64[3 + 4im], true, true)
        1     single_value = NIO.native_workspace_value([real_signal])
        1     library_value = NIO.native_workspace_value([real_signal, complex_signal])
        2     @test single_value isa Vector{Float64} && single_value == [1.0, 2.0]
        1     @test library_value isa Dict{String,Any}
        1     @test library_value["one"] == [1.0, 2.0]
        1     @test library_value["two"] == ComplexF64[3 + 4im]
