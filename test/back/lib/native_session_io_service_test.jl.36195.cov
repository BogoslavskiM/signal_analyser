        1     source = NIO.source("lib", "services", "native_session_io_service.jl")
        2     @test occursin("root_real = realpath", source) && occursin("child_real = try\n                realpath(child)", source)
        2     @test occursin("inside(child_real) || continue", source) && occursin("startswith(name, \".\") && continue", source)
        2     @test occursin("item.kind == \"directory\" ? 0 : 1", source) && occursin("sort_direction", source)
        2     @test occursin("native_remote_file_write_script", source) && occursin("finally\n            !isempty(temp)", source)
        2     @test occursin("NATIVE_IO_SCRATCH_NAME", source) && occursin("transfer_lock::ReentrantLock", source)
        2     @test occursin("previous = native_engee_recv(service.scratch_name)", source) && occursin("internal_name_conflict", source)
        1     @test length(collect(eachmatch(r"lock\(service\.transfer_lock\) do", source))) == 3
        1     @test length(collect(eachmatch(r"native_clear_scratch\(service\)", source))) == 3
        2     @test occursin("NATIVE_REPRODUCER_MAX_BYTES", source) && occursin("script_too_large", source)
        2     @test occursin("NATIVE_SIGNAL_JLD2_SCHEMA", source) && occursin("imag_values = payload.imag_values", source)
        2     @test occursin("__genie_app_name", source) && occursin("SIGNAL_ANALYSER_SESSION_VERSION", source)
        2     @test occursin("signal_analyser_session_candidate", source) && occursin("signal_analyser_publish_session!", source)
        1     @test occursin("command.state_revision == state.view.state_revision", source)
        1     @test occursin("scope = length(names) == 1 ? \"signal\" : \"library\"", source)
        1     @test occursin("length(signals) == 1 && return native_signal_value(only(signals))", source)
        2     @test occursin("values = Dict{String,Any}()", source) && occursin("values[signal.name] = native_signal_value(signal)", source)
        1     workspace_start = first(findfirst("function native_save_workspace", source))
        1     workspace_end = first(findfirst("function native_float_vector_literal", source))
        1     workspace_save = source[workspace_start:(workspace_end - 1)]
        1     @test length(collect(eachmatch(r"native_workspace_preflight\(target\)", workspace_save))) == 1
        1     @test length(collect(eachmatch(r"native_engee_send\(target, native_workspace_value\(signals\)\)", workspace_save))) == 1
        1     @test length(collect(eachmatch(r"\"variable_name\" => target", workspace_save))) == 1
        1     @test first(findfirst("if !command.overwrite && existed", workspace_save)) <
        -         first(findfirst("native_engee_send(target", workspace_save))
        2     @test occursin("command.operation == \"session\"", source) &&
        -         first(findfirst("if command.operation == \"session\"", source)) <
        -         first(findfirst("signals = native_snapshot_signals", source))
